{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/player/[id]",
      "regex": "^/api/player/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/player/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/jogo/[territory]",
      "regex": "^/jogo/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPterritory": "nxtPterritory"
      },
      "namedRegex": "^/jogo/(?<nxtPterritory>[^/]+?)(?:/)?$"
    },
    {
      "page": "/missoes/[id]",
      "regex": "^/missoes/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/missoes/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
